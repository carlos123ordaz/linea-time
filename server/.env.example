# Puerto del API
PORT=4000

# Mongo. Si lo dejas vacio el server levanta una MongoDB en memoria (solo para probar).
# Local:  mongodb://127.0.0.1:27017/line-love
# Atlas:  mongodb+srv://usuario:password@cluster.xxxx.mongodb.net/line-love
MONGODB_URI=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Origen permitido para el front
CLIENT_ORIGIN=http://localhost:5173
